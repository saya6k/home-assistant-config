# ============================================================
# Allow-list gitignore: deny by default, allow specific types.
# ============================================================

# Default: ignore everything
*

# --- Allow source / config / docs file types ---
!*.yaml
!**/.??*.yaml
!*.yml
!**/.??*.yml
!*.md
!*.toml
!*.j2

# --- Allow specific JSON (avoid leaking credentials.json etc.) ---
!.releaserc
!.github/workflows/*.json

# --- Allow docs assets (restricted to docs/) ---
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.svg
!docs/**/*.css

# --- Allow text/config files without extensions ---
!LICENSE
!CODEOWNERS
!.prettierignore
!.gitkeep

# --- Re-allow directory traversal so the rules above can reach nested files ---
!*/

# ============================================================
# Re-ignore directories that contain runtime / generated / 3rd-party content.
# Once a directory is matched here it cannot be re-included file-by-file
# (gitignore "parent directory excluded" rule). Add explicit `!path` rules
# below where individual files must still travel with the repo.
# ============================================================

# Brand icon cache regenerated from home-assistant/brands
.cache/

# Home Assistant Cloud account state
.cloud/

# Locally-installed integration deps
deps/

# Camera snapshots
image/

# TTS audio cache
tts/

# Voice satellite models/sounds
voice_satellite/

# HA frontend resources (HACS-managed)
www/

# HACS custom components — recoverable via HACS at restore time
custom_components/*
!custom_components/.gitkeep

# .storage/ state (auth, registries, integration data) — only the lovelace
# dashboard files travel with the repo
.storage/*
!.storage/lovelace
!.storage/lovelace_dashboards
!.storage/lovelace_resources
!.storage/lovelace.*

# ============================================================
# Re-ignore individual files even though they match an allow-rule above
# ============================================================

# macOS metadata
._*
.DS_Store

# Secrets (any secrets*.yaml at any depth, incl. esphome/; CI generates mocks)
secrets*.yaml
secrets*.yml

# Runtime state written by HA / supervisor
.HA_VERSION
.ha_run.lock
ip_bans.yaml
home-assistant.log
home-assistant.log.*
*.fault

# zensical CI staging dir (built from docs/ in the pages workflow)
docs/ko/

# Local build / dev artifacts
_site/
_build/
