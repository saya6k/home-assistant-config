{#-
docs/integrations/custom-components.md — loaded custom integrations from `custom_components`.

Categorization is editorial — defined here as domain → group mapping.
Unknown domains fall into "기타".
-#}
{%- set integrations = custom_components -%}
{%- set categories = {
    '한국 서비스 / 지역': ['kr_public_data', 'chzzk', 'naver_map', 'pweb_amano'],
    '가전 / 디바이스': ['dyson_local', 'localthings', 'xbloom', 'wardrowbe', 'ancs'],
    '위치 / 존재': ['life360'],
    '데이터 / 외부': ['truenas_ce'],
    '유틸리티': [
        'jinja_files', 'spook', 'spook_calibration', 'spook_inverse',
        'spook_time_in_state', 'restore_persistent_notifications',
    ],
} -%}
{%- set categorized_domains = [] -%}
{%- for domains in categories.values() %}{% set _ = categorized_domains.extend(domains) %}{% endfor -%}
{%- set int_by_domain = {} -%}
{%- for c in integrations %}{% set _ = int_by_domain.update({c.domain: c}) %}{% endfor -%}
{#- Domains present in analytics.home-assistant.io/custom_integrations.json get an
    "active installations" badge (via shields.io dynamic JSON). Domains not listed
    there have no public stats, so they render "—". Add a domain here once it appears
    in HA's custom-integrations analytics. -#}
{%- set analytics_domains = [
    'dyson_local', 'life360', 'spook', 'restore_persistent_notifications',
] -%}
{%- set badge_base = 'https://img.shields.io/badge/dynamic/json?url=https%3A%2F%2Fanalytics.home-assistant.io%2Fcustom_integrations.json&query=%24.' -%}
{%- set badge_tail = '.total&label=installs&color=2ea44f&style=flat-square' -%}
